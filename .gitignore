# Explicit root allowlist: private working files are excluded by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.txt
!/LOG_SCHEMA_FOR_AI.md
!/THIRD_PARTY_NOTICES.md
!/start.bat
!/start-server.bat
!/start-server.ps1
!/build-plugin.ps1
!/java-tools.ps1
!/package-release.ps1
!/publication-files.txt
!/plugin-src/
/plugin-src/build/
!/tests/
!/server/
/server/*
!/server/proxy/
/server/proxy/*
!/server/proxy/LocalPlayerLoggerProxy.jar
!/server/proxy/localplayerlogger-proxy.properties.example

# Runtime/session files are never publication inputs.
**/logs/
**/session-logs/
**/crash-reports/
**/.console_history
*.log
*.log.gz
*.jsonl
*.bin
*.class
*.jar.new
*.next.jar
*.tmp
